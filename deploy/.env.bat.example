@echo off
REM ============================================================================
REM  AirFlow Lite - Variaveis de ambiente
REM ----------------------------------------------------------------------------
REM  Copie este arquivo para "deploy\.env.bat" e ajuste os valores.
REM  setup.bat faz essa copia automaticamente e gera a SECRET_KEY.
REM  start.bat carrega este arquivo (call .env.bat) antes de iniciar o servidor.
REM ============================================================================

REM Chave secreta para sessoes/CSRF. Gere uma com:
REM   python -c "import secrets; print(secrets.token_hex(32))"
set SECRET_KEY=MUDE-ESTA-CHAVE-EM-PRODUCAO

REM Whitelist de diretorios onde os scripts .py podem estar (separe com ;).
REM CRITICO para seguranca: so estes diretorios poderao ser executados.
set ALLOWED_SCRIPT_DIRS=C:\scripts\producao

REM Banco de dados (SQLAlchemy URL). Padrao: SQLite na raiz do projeto.
set DATABASE_URL=sqlite:///C:/airflow-lite/airflow_lite.db

REM Timeout padrao de execucao (segundos) e tamanho maximo do log (bytes).
set DEFAULT_TIMEOUT=3600
set MAX_LOG_SIZE=51200

REM Host/porta/threads do servidor de producao (Waitress).
set HOST=0.0.0.0
set PORT=5000
set THREADS=8
